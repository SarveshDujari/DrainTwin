# Set these in the backend shell or load with python-dotenv. Never commit secrets.
# Offline summaries are the submission default. Set to 1 for optional AI prose.
STRANDS_ENABLED=0
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
AI_TIMEOUT_SECONDS=35
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
